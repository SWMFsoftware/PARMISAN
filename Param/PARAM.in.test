#CPUTIMEMAX
28440       CpuTimeMax # 28440

#READMHDATA
T                     DoReadMhData
/home/adshane/TestFieldline/    NameInputDir
1       iLonFile
1       iLatFile

#MHDATA
ascii       TypeFile
MH_data.lst     NameTagFile

#COORDSYSTEM
GSM      TypeCoordSystem

#FIELDLINEGRID
1    nLon
1    nLat

#STOP
5000       nIterMax
120        TimeMax # [s] max = 153720

#BOUNDARY
reflect     BoundaryInner
absorb      BoundaryOuter

#ADVECTION
F       UseLogScaling
T       UseAdvectedRho
F       DoScaleDlogRho

#IDENTIFYSHOCK
5         nShockWidth
3         nSearchMax
-0.01     dLogRhoThreshold
T         DoOutputShock

#SDEBINNING
T           DoBinEntireFieldline
400         nLagrBins
120         BinTimeWindow

#DISTRIBUTION
200         nEnergyBin
10.0        eBinMin      # [keV]
1e7         eBinMax      # [keV]
10.0        InjEnergy    # [keV]
1.0         InjCoeff

#SDE
1.0         TimeStepFactor   # 0.01
0.01        MaxTimeStep # [s]

#DIFFUSION
1.0         DxxFactor
T           UseConstantDiffusion
10.0        DxxConst

#PARTICLE
0               nInject        # how many particles injected per lagrangian coordinate
F               UseSplit
40              nSplit         # number of energy thresholds where splitting occurs
1.0             SplitEnergyMin # [MeV]
100.0           SplitEnergyMax # [MeV]

#INPUTSEED
F               UseInputSeedFile

#TEST
T           DoRunTest

#END