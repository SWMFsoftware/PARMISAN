#CPUTIMEMAX
28440       CpuTimeMax # 28440

#READMHDATA
T                     DoReadMhData
/mnt/e/TestFieldline   NameInputDir
1       iLonFile
1       iLatFile

#MHDATA
ascii       TypeFile
MH_data.lst     NameTagFile

#COORDSYSTEM
GSM      TypeCoordSystem

#FIELDLINEGRID
1    nLon
1    nLat

#STOP
5000       nIterMax
500        TimeMax # [s]

#BOUNDARY
reflect     BoundaryInner
absorb      BoundaryOuter

#ADVECTION
F       UseLogScaling
F       UseAdvectedRho

#SHOCK
F         DoScaleShock
F         DoSharpenShock
300       nSearchMax
0.0       dLogRhoThreshold

#SDEBINNING
T           DoBinEntireFieldline
400         nLagrBins
120         BinTimeWindow

#DISTRIBUTION
200         nEnergyBin
10.0        eBinMin      # [keV]
1e7         eBinMax      # [keV]
10.0        InjEnergy    # [keV]
1.0         InjCoeff

#SDE
1.0         TimeStepFactor   # 0.01
0.01        MaxTimeStep # [s]

#DIFFUSION
1           UpstreamDxxModel     # (1) MHD (2) PSP (3) analytical
20.0        DxxFactor            # Reduce Dxx within shock by this factor
T           UseConstantDiffusion
10.0        DxxConst

#PARTICLE
0               nInject        # how many particles injected per lagrangian coordinate
F               UseSplit
40              nSplit         # number of energy thresholds where splitting occurs
1.0             SplitEnergyMin # [MeV]
100.0           SplitEnergyMax # [MeV]

#INPUTSEED
F               UseInputSeedFile

#TEST
T           DoRunTest

#END